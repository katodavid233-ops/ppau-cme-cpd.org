<%- include('../partials/header', { title: 'Manage Users' }) %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<section class="page-header py-4">
  <div class="container">
    <h4 class="fw-bold mb-0"><i class="bi bi-people"></i> Manage Users</h4>
    <div class="text-white-50 small">View admin accounts.</div>
  </div>
</section>

<section class="py-4">
  <div class="container">
    <div class="card">
      <div class="card-body p-0">
        <% if (users && users.length) { %>
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Role</th><th>Created</th></tr></thead>
              <tbody>
                <% users.forEach(function(u) { %>
                  <tr>
                    <td><%= u.id %></td>
                    <td><%= u.full_name %></td>
                    <td><%= u.email %></td>
                    <td><span class="badge text-bg-<%= u.role === 'admin' ? 'primary' : 'secondary' %>"><%= u.role %></span></td>
                    <td class="small"><%= u.created_at %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="text-center py-5 text-secondary">No users.</div>
        <% } %>
      </div>
    </div>
    <div class="mt-3"><a href="/admin" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Back to dashboard</a></div>
  </div>
</section>

<%- include('../partials/footer') %>
