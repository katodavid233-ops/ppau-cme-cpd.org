<%- include('../partials/header', { title: 'Review Submissions' }) %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<section class="page-header py-4">
  <div class="container">
    <h4 class="fw-bold mb-0"><i class="bi bi-inbox"></i> Submissions Review</h4>
    <div class="text-white-50 small">Review "Other Ways and Activities" submissions and award points.</div>
  </div>
</section>

<section class="py-4">
  <div class="container">
    <% if (submissions && submissions.length) { %>
      <% submissions.forEach(function(s) { %>
        <div class="card mb-3">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <h6 class="fw-bold"><%= s.title %></h6>
                <p class="small text-secondary mb-1"><strong><%= s.full_name %></strong> &mdash; PPAU: <%= s.ppau_reg_no %></p>
                <p class="small mb-2"><%= s.description %></p>
                <% if (s.evidence_file) { %>
                  <p class="small"><i class="bi bi-paperclip"></i> Evidence file: <%= s.evidence_file %></p>
                <% } %>
              </div>
              <div class="text-end">
                <span class="badge text-bg-<%= s.status === 'approved' ? 'success' : s.status === 'rejected' ? 'danger' : 'warning' %> mb-2"><%= s.status %></span>
                <% if (s.status === 'pending') { %>
                  <form method="post" action="/admin/submission/<%= s.id %>/approve" class="d-inline">
                    <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check-circle"></i> Approve</button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div class="text-center py-5 text-secondary">
        <i class="bi bi-inbox fs-1 d-block mb-2"></i>No submissions to review.
      </div>
    <% } %>
    <div class="mt-3"><a href="/admin" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Back to dashboard</a></div>
  </div>
</section>

<%- include('../partials/footer') %>
