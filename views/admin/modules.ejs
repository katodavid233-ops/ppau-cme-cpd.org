<%- include('../partials/header', { title: 'Manage Modules' }) %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<section class="page-header py-4">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-laptop"></i> Manage Modules</h4>
        <div class="text-white-50 small">Create, edit and manage CPD modules.</div>
      </div>
      <a href="/admin/modules/new" class="btn btn-success btn-sm"><i class="bi bi-plus-circle"></i> New Module</a>
    </div>
  </div>
</section>

<section class="py-4">
  <div class="container">
    <div class="card">
      <div class="card-body p-0">
        <% if (modules && modules.length) { %>
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead><tr><th>ID</th><th>Title</th><th>Style</th><th>Points</th><th>Questions</th><th>Status</th></tr></thead>
              <tbody>
                <% modules.forEach(function(m) { %>
                  <tr>
                    <td><%= m.id %></td>
                    <td class="fw-semibold"><%= m.title %></td>
                    <td><span class="badge text-bg-light text-dark"><%= m.style %></span></td>
                    <td><%= m.credit_points %></td>
                    <td>—</td>
                    <td><span class="badge text-bg-<%= m.is_published ? 'success' : 'secondary' %>"><%= m.is_published ? 'Active' : 'Inactive' %></span></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="text-center py-5 text-secondary">No modules yet. <a href="/admin/modules/new">Create one</a>.</div>
        <% } %>
      </div>
    </div>
    <div class="mt-3"><a href="/admin" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Back to dashboard</a></div>
  </div>
</section>

<%- include('../partials/footer') %>
